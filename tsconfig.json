{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "for-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "for-jsx/jsx-runtime": ["./src/jsx/FOR_JSX/jsx-runtime.ts"],
      "for-jsx/jsx-dev-runtime": ["./src/jsx/FOR_JSX/jsx-dev-runtime.ts"],
      "regan": ["./src/regan.ts"],
      "regan/vite": ["./src/subpackages/vite.ts"],
      "regan/jsx-runtime": ["./src/regan.ts"],
      "regan/jsx-dev-runtime": ["./src/regan.ts"]
    }
  },
  "include": ["./src/**/*.tsx", "./src/**/*.ts"],
  "files": ["jsx.global.d.ts"]
}
