{
  "name": "regan",
  "version": "0.0.15",
  "description": "",
  "main": "./dist/regan.js",
  "types": "./dist/types/regan.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/regan.d.ts",
      "default": "./dist/regan.js"
    },
    "./jsx-runtime": {
      "types": "./dist/types/regan.d.ts",
      "default": "./dist/regan.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/types/regan.d.ts",
      "default": "./dist/regan.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "coverage": "bun test --coverage",
    "types": "tsc --project tsconfig.json",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/regan.ts --outdir=./dist --format=esm --external=strangelove --minify",
    "build:types": "tsc --project tsconfig.gen.json",
    "watch": "bun build ./src/regan.ts --outdir=./dist --format=esm --external=strangelove --watch"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "strangelove": ">=2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "utftu": "^1.0.31"
  }
}